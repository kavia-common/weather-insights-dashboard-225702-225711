# Optional overrides used by the app
REACT_APP_API_BASE=https://api.openweathermap.org
# REQUIRED: Your OpenWeatherMap API key (One Call 3.0 + Geocoding)
REACT_APP_OPENWEATHER_API_KEY=YOUR_OWM_API_KEY_HERE

# Existing variables (if used by your environment)
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
